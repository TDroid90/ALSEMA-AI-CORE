# Copy to .env and replace CHANGE_ME values.
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_VALUE
POSTGRES_DB=alsema
POSTGRES_USER=alsema
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://alsema:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/alsema
REDIS_URL=redis://redis:6379/0
# Leave both blank to create the administrator in the first-run web screen.
# Set both values together to provision it non-interactively.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
OLLAMA_BASE_URL=http://host.docker.internal:11434
CREATIVE_STORAGE_ROOT=/data/creative
CREATIVE_TEXT_MODEL=qwen3:8b
COMFYUI_BASE_URL=http://host.docker.internal:8188
# Optional OpenAI-compatible fallback. Empty keeps it disabled.
LM_STUDIO_BASE_URL=
API_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
PLUGIN_RUNTIME_MODE=docker_sandbox
PLUGIN_DOCKER_PROXY_URL=http://docker-proxy:2375/v1.44
PLUGIN_SANDBOX_IMAGE=python:3.12-slim
# Persistent, container-local sandbox for the approved file tool.
TOOL_SANDBOX_ROOT=/data/tools
# Comma-separated outbound HTTP host allowlist. Empty means outbound HTTP is disabled.
HTTP_ALLOWED_HOSTS=
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RESPONSE_BYTES=1000000
MAX_REQUEST_BODY_BYTES=2000000
# Independent stable master key for encrypted plugin credentials. Generate a long random value.
SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_SEPARATE_LONG_RANDOM_VALUE
# Optional development bootstrap. Leave all credential fields blank to configure accounts from the UI.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0
INSTAGRAM_ACCOUNT_LABEL=Development Instagram
INSTAGRAM_PROCESSING_POLL_SECONDS=5
INSTAGRAM_PROCESSING_TIMEOUT_SECONDS=600
